    "@x402/express": "2.23.0",
    "@x402/extensions": "2.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
