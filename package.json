  "dependencies": {
    "@peac/crypto": "0.16.4",
    "@peac/kernel": "0.16.4",
    "@peac/protocol": "0.16.4",
    "@peac/schema": "0.16.4",
    "@x402/core": "2.23.0",
    "@x402/evm": "2.23.0",
    "@x402/express": "2.23.0",
    "@x402/extensions": "2.23.0",
    "express": "5.2.1",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
