    "demo:fixture": "tsx src/flow/fixture-e2e.ts",
    "demo:offline": "tsx src/fixture-demo-offline.ts",
    "demo:live:prepare": "tsx src/flow/preflight.ts",
    "verify": "tsx src/flow/verify-evidence.ts",
    "tamper-demo": "tsx src/flow/tamper-demo.ts",
    "test": "pnpm test:reset && pnpm test:imports && pnpm test:golden && pnpm test:negative && pnpm test:ledger-integrity && pnpm test:flow && pnpm test:flow:node && pnpm test:evm && pnpm test:projection && pnpm test:terminal && pnpm test:rpc && pnpm test:durability && pnpm test:chain-schema && pnpm test:x402-revalidation && pnpm test:acceptance && pnpm typecheck && pnpm typecheck:compat",
    "test:reset": "tsx src/acceptance-reset.ts",
    "test:imports": "tsx src/imports-smoke.ts",
    "test:golden": "tsx src/test-golden.ts",
    "test:negative": "tsx src/test-negative.ts",
    "test:ledger-integrity": "tsx src/test-ledger-integrity.ts",
    "test:flow": "tsx src/flow/fixture-e2e.ts",
    "test:flow:node": "node src/flow/fixture-e2e.ts",
    "test:evm": "tsx src/test-evm-matrix.ts",
    "test:projection": "tsx src/test-evidence-projection.ts",
    "test:terminal": "tsx src/test-terminal-safe.ts",
    "test:rpc": "tsx src/test-rpc-transport.ts",
    "test:durability": "tsx src/test-durability.ts",
    "test:chain-schema": "tsx src/test-chain-schema.ts",
    "test:x402-revalidation": "tsx src/test-x402-revalidation.ts",
    "test:acceptance": "tsx src/test-acceptance.ts",
