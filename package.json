    "test": "pnpm test:reset && pnpm test:imports && pnpm test:golden && pnpm test:negative && pnpm test:ledger-integrity && pnpm test:acceptance && pnpm typecheck && pnpm typecheck:compat",
    "test:reset": "tsx src/acceptance-reset.ts",
    "test:imports": "tsx src/imports-smoke.ts",
    "test:golden": "tsx src/test-golden.ts",
    "test:negative": "tsx src/test-negative.ts",
    "test:ledger-integrity": "tsx src/test-ledger-integrity.ts",
    "test:acceptance": "tsx src/test-acceptance.ts",
    "gen:golden": "tsx src/gen-golden.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:compat": "./run-ts-compat.sh"
  },
  "dependencies": {
    "@peac/crypto": "0.16.4",
    "@peac/kernel": "0.16.4",
    "@peac/protocol": "0.16.4",
    "@peac/schema": "0.16.4",
    "@x402/core": "2.23.0",
