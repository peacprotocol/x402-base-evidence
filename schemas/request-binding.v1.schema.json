{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peacprotocol.org/examples/payment-evidence/request-binding/1",
  "$comment": "$id is a namespace identifier, not a retrieval promise: this URL is not guaranteed to be dereferenceable.",
  "title": "Payment-evidence example request binding (non-normative)",
  "description": "Application-local profile for this example. Does not extend the PEAC wire format, record registry, extension registry or conformance requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "components", "bodyDigest", "selectedHeaders"],
  "properties": {
    "profile": { "const": "org.peacprotocol.examples.payment-evidence/request-binding/1" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@method", "@scheme", "@authority", "@path", "@query", "capturePoint", "proxyTrustProfile"],
      "properties": {
        "@method": { "type": "string", "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$" },
        "@scheme": { "enum": ["http", "https"] },
        "@authority": { "type": "string", "minLength": 1 },
        "@path": { "type": "string", "pattern": "^/" },
        "@query": { "type": "string", "pattern": "^\\?" },
        "capturePoint": { "const": "origin_request_after_http_parsing" },
        "proxyTrustProfile": {
          "enum": ["direct-origin"],
          "description": "Only direct-origin is implemented in this reference. A trusted-proxy profile is a real feature (trusted-hop policy, Forwarded/X-Forwarded-* precedence, spoofing rejection) this repository does not implement, so no such value is advertised here."
        }
      }
    },
    "contentType": { "type": "string" },
    "contentEncoding": { "type": "string" },
    "bodyDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "selectedHeaders": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "observedValueDigest"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" },
          "observedValueDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
